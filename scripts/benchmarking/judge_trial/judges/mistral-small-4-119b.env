# Mistral Small 4 119B (FP8 checkpoint): reserve. Mistral recommends TP=2 (121 GB of
# weights), so two H200. The config advertises 1M positions but Mistral serves it at 256k,
# and the recipe warns that 2 x H200 can run out of memory at 256k, so 64k here (every
# golden-set judge prompt is under 26k tokens). The model is multimodal: images are
# disabled. Reasoning parser "mistral"; reasoning_effort accepts only "none" or "high".
# "none" here; a "high" arm is a copy of this file with that one change.
JUDGE_MODEL_ID=mistralai/Mistral-Small-4-119B-2603
JUDGE_MODEL_REVISION=a11f36bebf709121056b1dbcc943d1c6afbe494d
JUDGE_PRECISION=checkpoint
# Required by the shared judge.env parser; the trial's own status uses it as a prior only.
JUDGE_BOOTSTRAP_ROWS_PER_MINUTE=20
JUDGE_GPUS=2
JUDGE_MEM=256G
JUDGE_TIME=10:00:00
JUDGE_SERVER_ARGS=--max-model-len 65536 --reasoning-parser mistral --limit-mm-per-prompt '{"image":0}' --max-num-batched-tokens 16384 --gpu-memory-utilization 0.85
JUDGE_REASONING_EFFORT=none
JUDGE_MAX_TOKENS=4096
JUDGE_SEED=20261027
