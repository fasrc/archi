# Nemotron 3 Super 120B-A12B FP8: second judge (NVIDIA, independent of gpt-oss). The
# model card's minimum is 2 x H100-80GB and the FP8 weights are 128 GB, so two H200.
# Flags from the model card: fp8 KV cache, float32 Mamba state, trust-remote-code, the
# nemotron_v3 reasoning parser. Thinking is on by default; {"enable_thinking": false}
# switches it off, {"enable_thinking": true, "low_effort": true} shortens it.
JUDGE_MODEL_ID=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-FP8
JUDGE_MODEL_REVISION=744b1880a37996c5d56bf454ae164dfd74d77c4e
JUDGE_PRECISION=checkpoint
# Required by the shared judge.env parser; the trial's own status uses it as a prior only.
JUDGE_BOOTSTRAP_ROWS_PER_MINUTE=20
JUDGE_GPUS=2
JUDGE_MEM=256G
JUDGE_TIME=10:00:00
JUDGE_SERVER_ARGS=--max-model-len 65536 --kv-cache-dtype fp8 --mamba-ssm-cache-dtype float32 --trust-remote-code --reasoning-parser nemotron_v3 --gpu-memory-utilization 0.90
JUDGE_CHAT_TEMPLATE_KWARGS={"enable_thinking": true}
JUDGE_MAX_TOKENS=8192
JUDGE_SEED=20261027
