# gpt-oss-120b: first pick. MXFP4 weights (65 GB) on one H200. vLLM applies the harmony
# reasoning format itself for model_type gpt_oss, so no --reasoning-parser is passed (the
# vLLM recipe passes none). The lowest reasoning effort is "low"; thinking cannot be
# switched off. Comments must be on their own line in this file.
JUDGE_MODEL_ID=openai/gpt-oss-120b
JUDGE_MODEL_REVISION=b5c939de8f754692c1647ca79fbf85e8c1e70f8a
JUDGE_PRECISION=checkpoint
# Required by the shared judge.env parser; the trial's own status uses it as a prior only.
JUDGE_BOOTSTRAP_ROWS_PER_MINUTE=20
JUDGE_GPUS=1
JUDGE_MEM=200G
JUDGE_TIME=08:00:00
JUDGE_SERVER_ARGS=--max-model-len 65536 --max-num-batched-tokens 8192 --gpu-memory-utilization 0.92
JUDGE_REASONING_EFFORT=medium
JUDGE_MAX_TOKENS=8192
JUDGE_SEED=20261027
